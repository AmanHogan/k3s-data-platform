# Example only (".example": ArgoCD and kustomize ignore it). Never fill it in git.
# Create the real Secret on the Mac with:
#   kubectl create secret generic stream-api -n stream --from-literal=token="$(openssl rand -hex 32)"
# Read it back (for the web form and the browser extension) with:
#   kubectl get secret stream-api -n stream -o jsonpath='{.data.token}' | base64 -d; echo
apiVersion: v1
kind: Secret
metadata:
  name: stream-api
  namespace: stream
type: Opaque
stringData:
  token: CHANGE-ME
